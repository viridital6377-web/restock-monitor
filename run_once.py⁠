import os
import requests

# 讀取環境變數
BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")

print("=== DEBUG START ===")
print(f"Token length: {len(BOT_TOKEN) if BOT_TOKEN else 0}")
print(f"Chat ID length: {len(CHAT_ID) if CHAT_ID else 0}")

if not BOT_TOKEN or not CHAT_ID:
    print("Error: Missing Telegram credentials!")
    exit(1)

# 測試 Telegram 發送
url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
payload = {
    "chat_id": CHAT_ID,
    "text": "🎉 測試訊息：GitHub Actions 監控腳本連線成功！"
}

try:
    response = requests.post(url, json=payload, timeout=10)
    res_data = response.json()
    print("Telegram API Response:", res_data)
    
    if res_data.get("ok"):
        print("訊息發送成功！")
        # 成功後寫入紀錄檔
        with open("seen_items.json", "w", encoding="utf-8") as f:
            f.write("{}")
        print("seen_items.json 已成功建立！")
    else:
        print("Telegram 發送失敗，錯誤原因:", res_data.get("description"))

except Exception as e:
    print("請求發生異常:", str(e))

print("=== DEBUG END ===")
